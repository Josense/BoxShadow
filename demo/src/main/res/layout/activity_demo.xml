<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAFAFC">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="2" android:background="#E7EBF2">
        <com.josense.boxshadow.BoxShadowLayout android:id="@+id/preview"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" app:boxCornerRadius="18dp"
            app:boxBackground="@drawable/card_gradient"
            app:boxStrokeWidth="2dp" app:boxStrokeColor="#6886BB"
            app:boxFillColor="#FFFFFF" app:innerShadowColor="#88506388"
            app:innerShadowBlurRadius="6dp" app:innerShadowSpread="1dp" app:innerShadowOffsetY="3dp"
            app:shadowBlurRadius="10dp" app:shadowOffsetY="5dp" app:shadowColor="#66304870">
            <TextView android:id="@+id/card" android:layout_width="132dp" android:layout_height="60dp"
                android:gravity="center" android:text="Box Shadow" android:textColor="#203452" android:textSize="18sp"/>
        </com.josense.boxshadow.BoxShadowLayout>
    </FrameLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3">
        <LinearLayout android:id="@+id/controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"/>
    </ScrollView>
</LinearLayout>
